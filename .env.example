VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# NOTE: All VITE_* values are bundled into the client and are publicly visible.
# That is fine for the Firebase web config above (it is not a secret; access is
# enforced by Realtime Database rules in database.rules.json).
# Do NOT add a Firebase database secret / admin token here — it would be shipped
# to every browser and grant the world full read/write. The app authenticates
# the REST fallback with the signed-in user's ID token instead.
